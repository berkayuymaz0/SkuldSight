{
  "manifest_version": 3,
  "name": "PixelPaw SOC",
  "version": "1.0.3",
  "description": "Chrome MV3 extension for SOC analysts: scan IPs, domains, URLs & hashes via VirusTotal, with AbuseIPDB, batch scans & on-page IOC badges.",
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    },
    "default_title": "PixelPaw SOC"
  },
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "src/background/background.js"
  },
  "side_panel": {
    "default_path": "src/popup/popup.html?surface=sidepanel"
  },
  "options_page": "src/options/options.html",
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "clipboardWrite",
    "alarms",
    "sidePanel"
  ],
  "host_permissions": [
    "https://securityweek.com/*",
    "https://www.securityweek.com/*",
    "https://cyberscoop.com/*",
    "https://www.bleepingcomputer.com/*",
    "https://feeds.feedburner.com/*",
    "https://thehackernews.com/*",
    "https://krebsonsecurity.com/*",
    "https://www.virustotal.com/*",
    "https://www.cyberscoop.com/*",
    "https://www.usom.gov.tr/*",
    "https://api.abuseipdb.com/*"
  ],
  "web_accessible_resources": [],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["src/shared/i18n.js", "src/content/content-utils.js", "src/content/detect.js", "src/content/panel.js", "src/content/scan.js", "src/content/observe.js"],
      "css": ["styles/tokens.css", "styles/content.css"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: https:; connect-src 'self' https://www.virustotal.com https://api.abuseipdb.com https://cyberscoop.com https://www.cyberscoop.com https://www.bleepingcomputer.com https://feeds.feedburner.com https://thehackernews.com https://securityweek.com https://www.securityweek.com https://krebsonsecurity.com https://www.usom.gov.tr; font-src 'self'; object-src 'none'; base-uri 'self';"
  }
}
